{
  "name": "alchemists-shop",
  "version": "2.4.0",
  "description": "The Alchemist's Shop \u2014 a physics-driven potion brewing browser game.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs --root . --port 5173",
    "serve:dist": "node scripts/serve.mjs --root dist --port 4173",
    "test": "node --test --test-concurrency=4 tests/*.test.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "node scripts/build.mjs",
    "bench": "node scripts/bench.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "assets:export": "node scripts/generate-ingredient-library.mjs",
    "assets:validate": "node --test tests/ingredient-atlases.test.mjs tests/ingredient-library.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "5.9.3"
  }
}
